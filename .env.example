# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (file/image storage) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@impactgridanalytics.com
CONTACT_EMAIL=hello@impactgridanalytics.com   # where contact-form messages are delivered

# --- Google ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# --- OpenAI (AI quote / assistant features) ---
OPENAI_API_KEY=

# --- Your existing backend services on Render ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
RENDER_API_BASE_URL=

# --- Payment suspension system ---
CRON_SECRET=            # long random string; Vercel sends it to the daily reminder job automatically
ADMIN_API_KEY=          # long random string; protects /api/admin/websites
SITE_STATUS_TOKEN=      # long random string; lets externally-hosted client sites call /api/site-status
ADMIN_EMAIL=            # optional; where "payment overdue: suspend?" alerts go (defaults to CONTACT_EMAIL)
OWN_HOSTS=              # optional; extra hostnames that are never suspension-checked (comma-separated)
