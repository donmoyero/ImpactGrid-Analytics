# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform (where Sign in / Get started send people; optional, this is the default) ---
NEXT_PUBLIC_PLATFORM_URL=https://platform.impactgridanalytics.com

# --- Resend (contact form email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@impactgridanalytics.com
CONTACT_EMAIL=hello@impactgridanalytics.com   # where contact-form messages are delivered

# --- Site ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
OWN_HOSTS=              # optional; extra hostnames that are never suspension-checked (comma-separated)
