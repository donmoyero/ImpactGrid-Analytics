# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared sign-in ---
# PRODUCTION: set to .impactgridanalytics.com on BOTH this project and the platform project, so one sign-in works on both.
# Leave EMPTY locally and on preview URLs (a cookie domain breaks sign-in on localhost).
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Platform (where people are sent after signing in; optional, this is the default) ---
NEXT_PUBLIC_PLATFORM_URL=https://platform.impactgridanalytics.com

# --- Resend (contact form email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@impactgridanalytics.com
CONTACT_EMAIL=hello@impactgridanalytics.com   # where contact-form messages are delivered

# --- Site ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
