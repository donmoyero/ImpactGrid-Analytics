# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared sign-in ---
# PRODUCTION: set to .shopplug.uk on BOTH this project and the platform project, so one sign-in works on both.
# Leave EMPTY locally and on preview URLs (a cookie domain breaks sign-in on localhost).
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Platform (where people are sent after signing in; optional, this is the default) ---
NEXT_PUBLIC_PLATFORM_URL=https://platform.shopplug.uk

# --- Resend (contact form email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@impactgridanalytics.com
CONTACT_EMAIL=hello@impactgridanalytics.com   # where contact-form messages are delivered

# --- Site ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Pexels (free art videos for the homepage hero; get a key at https://www.pexels.com/api/) ---
PEXELS_API_KEY=

# --- Domains (NameSilo reseller) ---
NAMESILO_API_KEY=
# Optional: NameSilo's test environment while building. Leave empty for the live API.
NAMESILO_API_URL=
# Our markup on NameSilo's wholesale price: price = cost x (1 + percent/100) + fixed (USD). Defaults: 30% and $0.
DOMAIN_MARKUP_PERCENT=30
DOMAIN_MARKUP_FIXED=0
